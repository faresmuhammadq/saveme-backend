<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Architecture gates: no app, no database, run first (spec 005). -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <!-- Domain rules: no framework, no database. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Application services against PostgreSQL. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- HTTP endpoints, validated against docs/openapi. -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- argon2id at the lowest cost: the baseline floor applies to deployments, not tests (spec 007, R-5). -->
        <env name="HASH_ARGON_MEMORY" value="1024"/>
        <env name="HASH_ARGON_TIME" value="1"/>
        <env name="HASH_ARGON_THREADS" value="1"/>
        <!-- Test-only Identity keys. Never used outside the test suite. -->
        <env name="IDENTITY_KEYS" value="{&quot;k1&quot;:&quot;aMwpk6RevtyluUTCOCwNrDZHmJNSN+BReF/sq8i+k7s=&quot;}"/>
        <env name="IDENTITY_ACTIVE_KEY" value="k1"/>
        <!-- Test-only Admin (operator sign-in) keys. Never used outside the test suite. -->
        <env name="ADMIN_KEYS" value="{&quot;a1&quot;:&quot;Z3VpbGR0ZXN0a2V5LWFkbWluLTAxMjM0NTY3ODkwMTI=&quot;}"/>
        <env name="ADMIN_ACTIVE_KEY" value="a1"/>
        <env name="ADMIN_LOOKUP_KEY" value="YWRtaW4tbG9va3VwLXRlc3Qta2V5LTAxMjM0NTY3ODk="/>
        <env name="ADMIN_CODE_KEY" value="YWRtaW4tY29kZS10ZXN0LWtleS0wMTIzNDU2Nzg5MDE="/>
        <env name="IDENTITY_LOOKUP_KEY" value="u1sMe5sEXD7vfBN9AnDfCC1RlB/NpuNcIQIBlFzUidA="/>
        <env name="ADMIN_NOTIFICATION_RECIPIENTS" value=""/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run on PostgreSQL, the production engine (ADR-0001, constitution P-16). -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="saveme_backend_main_test"/>
        <!-- Must stay empty: a DB_URL in .env would override host/database above. -->
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
