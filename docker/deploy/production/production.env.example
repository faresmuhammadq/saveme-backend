# Seeded into /srv/saveme/production/.env on the first deploy; later deploys only append new keys.
# Empty secrets and keyrings are generated by deploy-gate.sh. Edit the live .env, not this file.
IMAGE=ghcr.io/faresmuhammad/saveme-backend
IMAGE_TAG=production
APP_PORT=8092

APP_NAME="Save Me"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# LAN address of this machine; the phone and the e-mail links use it.
APP_URL=http://192.168.1.14:8092

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saveme_production
DB_USERNAME=saveme_production
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@saveme.local"
MAIL_FROM_NAME="Save Me"

# LAN only, served over plain HTTP: the API would otherwise refuse with 400 INSECURE_TRANSPORT.
# Set to true once the stack sits behind TLS.
API_REQUIRE_TLS=false

IDENTITY_KEYS=
IDENTITY_ACTIVE_KEY=
IDENTITY_LOOKUP_KEY=
IDENTITY_VERIFY_URL=http://192.168.1.14:8092/verify-email
IDENTITY_RESET_URL=http://192.168.1.14:8092/reset-password
IDENTITY_GOOGLE_ENABLED=false

ADMIN_KEYS=
ADMIN_ACTIVE_KEY=
ADMIN_LOOKUP_KEY=
ADMIN_CODE_KEY=
ADMIN_NOTIFICATION_RECIPIENTS=

SHARING_INVITATION_URL=http://192.168.1.14:8092/invite

HASH_ARGON_MEMORY=65536
HASH_ARGON_TIME=4
HASH_ARGON_THREADS=1

API_MIN_ANDROID_VERSION=1.0.0
API_MIN_WEB_VERSION=1.0.0

BILLING_GRACE_DAYS=3
BILLING_KEYS=
BILLING_ACTIVE_KEY=
BILLING_INSTAPAY_RENEW_URL=http://192.168.1.14:8092/renew
BILLING_SUPPORT_CONTACT=support@saveme.local

# fake and log drivers are refused outside local; switch to google / fcm once credentials exist.
BILLING_PLAY_DRIVER=disabled
BILLING_PLAY_PACKAGE=com.fares.saveme
BILLING_PLAY_ACCOUNT_KEYS=
BILLING_PLAY_ACCOUNT_ACTIVE_KEY=
BILLING_PLAY_LOOKUP_KEY=

NOTIFICATIONS_PUSH_DRIVER=disabled
NOTIFICATIONS_KEYS=
NOTIFICATIONS_ACTIVE_KEY=
NOTIFICATIONS_LOOKUP_KEY=
