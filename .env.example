APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the only supported engine (ADR-0001). `dev project env` fills
# these with this worktree's real values from the shared stack.
DB_CONNECTION=pgsql
DB_HOST=postgres-16
DB_PORT=5432
DB_DATABASE=saveme_backend_main
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identity (spec 007). Keys live in the secret store outside local.
# IDENTITY_KEYS is a JSON map {kid: base64 32-byte key}; generate with
#   php -r 'echo base64_encode(random_bytes(32));'
IDENTITY_KEYS=
IDENTITY_ACTIVE_KEY=
IDENTITY_LOOKUP_KEY=
IDENTITY_VERIFY_URL=
IDENTITY_RESET_URL=
IDENTITY_GOOGLE_ENABLED=false

# Operator sign-in (spec 018). Keys live in the secret store outside local.
# ADMIN_KEYS is a JSON map {kid: base64 32-byte key}; ADMIN_LOOKUP_KEY and ADMIN_CODE_KEY are
# separate base64 32-byte keys. Generate each with
#   php -r 'echo base64_encode(random_bytes(32));'
ADMIN_KEYS=
ADMIN_ACTIVE_KEY=
ADMIN_LOOKUP_KEY=
ADMIN_CODE_KEY=

# Sharing (spec 016): where an invitation link points; the token is appended as ?token=.
SHARING_INVITATION_URL=http://saveme-backend.test/invite

# Password hashing: the security baseline's argon2id floor.
HASH_ARGON_MEMORY=65536
HASH_ARGON_TIME=4
HASH_ARGON_THREADS=1

# Where operator notifications are emailed, comma-separated.
ADMIN_NOTIFICATION_RECIPIENTS=

# Minimum client versions accepted by the API (426 below them).
API_MIN_ANDROID_VERSION=1.0.0
API_MIN_WEB_VERSION=1.0.0

# Billing (spec 009): grace days for channels that set none.
BILLING_GRACE_DAYS=3

# InstaPay claims (spec 020). BILLING_KEYS is a JSON map {kid: base64 32-byte key}, like ADMIN_KEYS;
# it seals claim addresses and receipt images. Generate each key with
#   php -r 'echo base64_encode(random_bytes(32));'
BILLING_KEYS=
BILLING_ACTIVE_KEY=
BILLING_INSTAPAY_RENEW_URL=http://saveme-backend.test/renew
BILLING_SUPPORT_CONTACT=support@example.com

# Google Play (spec 024). Driver: google | fake | disabled. `fake` is scripted (local and tests only, refused
# at boot elsewhere); `google` needs every variable below; `disabled` (the default when unset) grants nothing.
# BILLING_PLAY_ACCOUNT_KEYS is a JSON map {kid: base64 32-byte key}; BILLING_PLAY_LOOKUP_KEY is a separate
# base64 32-byte key. Generate each with  php -r 'echo base64_encode(random_bytes(32));'
BILLING_PLAY_DRIVER=fake
BILLING_PLAY_PACKAGE=com.example.saveme
BILLING_PLAY_ACCOUNT_KEYS=
BILLING_PLAY_ACCOUNT_ACTIVE_KEY=
BILLING_PLAY_LOOKUP_KEY=
# BILLING_PLAY_FAKE_SCRIPT=
# BILLING_PLAY_CREDENTIALS=
# BILLING_PLAY_PUSH_AUDIENCE=https://api.example.com/api/v1/webhooks/google-play
# BILLING_PLAY_PUSH_SERVICE_ACCOUNT=
# BILLING_PLAY_PUSH_SUBSCRIPTION=projects/example-project/subscriptions/play-rtdn-push
# BILLING_PLAY_PRODUCT_PLUS_MONTHLY=plus_monthly
# BILLING_PLAY_PRODUCT_PLUS_YEARLY=plus_yearly
# BILLING_PLAY_PRICE_PLUS_MONTHLY=
# BILLING_PLAY_PRICE_PLUS_YEARLY=
# BILLING_PLAY_CURRENCY=EGP

# Devices & push (spec 023). NOTIFICATIONS_KEYS is a JSON map {kid: base64 32-byte key}, like BILLING_KEYS;
# it seals push tokens. NOTIFICATIONS_LOOKUP_KEY is a separate base64 32-byte key. Generate each with
#   php -r 'echo base64_encode(random_bytes(32));'
# Driver: fcm | log | disabled. `log` delivers nothing and is refused outside local and testing;
# `fcm` needs a project id and a service-account key (a path to the JSON file, or the JSON base64-encoded).
NOTIFICATIONS_PUSH_DRIVER=log
NOTIFICATIONS_KEYS=
NOTIFICATIONS_ACTIVE_KEY=
NOTIFICATIONS_LOOKUP_KEY=
# NOTIFICATIONS_FCM_PROJECT_ID=
# NOTIFICATIONS_FCM_CREDENTIALS=
